{
  "project_name": "FoodDatabase",
  "domain": "Software Development (C# Web-App)",
  "client": "mc.bcb86@googlemail.com",
  "created": "2026-06-06",
  "status": "active",

  "tech_stack": {
    "language": "C#",
    "backend": "ASP.NET Core",
    "frontend": "Blazor",
    "architecture": "Monolith",
    "database": "SQLite",
    "hosting": "Container on TrueNAS",
    "diagram_tool": "draw.io (XML-based)",
    "documentation": "HTML with embedded diagrams"
  },

  "agents": [
    {
      "name": "orchestrator",
      "role": "Dirigent / Product Owner / Teamleiter",
      "priority": 1,
      "status": "ready",
      "inputs": ["user_requirements"],
      "outputs": ["use_case_diagram", "framework_recommendation", "development_roadmap"],
      "communicates_with": ["user", "doc-agent", "review-agent"],
      "endpoint": "POST /orchestrator/analyze-requirements"
    },
    {
      "name": "doc-agent",
      "role": "Dokumentation & Diagramme",
      "priority": 2,
      "status": "ready",
      "inputs": ["use_case_diagram", "code", "tests", "architecture_decisions"],
      "outputs": ["class_diagram", "component_diagram", "deployment_diagram", "sequence_diagrams", "html_documentation"],
      "communicates_with": ["orchestrator", "dev-agent", "test-agent", "review-agent"],
      "endpoint": "POST /doc/create-diagrams, POST /doc/document"
    },
    {
      "name": "test-agent",
      "role": "TDD-Spezialist",
      "priority": 3,
      "status": "ready",
      "inputs": ["use_case_specification", "class_diagram", "component_diagram"],
      "outputs": ["test_code", "test_documentation"],
      "communicates_with": ["orchestrator", "doc-agent", "dev-agent", "review-agent"],
      "endpoint": "POST /test/write-test"
    },
    {
      "name": "dev-agent",
      "role": "C#-Developer",
      "priority": 4,
      "status": "ready",
      "inputs": ["test_code", "class_diagram", "component_diagram", "use_case_specification"],
      "outputs": ["implementation_code", "inline_documentation"],
      "communicates_with": ["test-agent", "doc-agent", "review-agent"],
      "endpoint": "POST /dev/implement-code"
    },
    {
      "name": "review-agent",
      "role": "Quality Assurance & Code Review",
      "priority": 5,
      "status": "ready",
      "inputs": ["test_code", "implementation_code", "class_diagram"],
      "outputs": ["review_report", "feedback", "escalation_notice"],
      "communicates_with": ["test-agent", "dev-agent", "doc-agent", "orchestrator", "user"],
      "endpoint": "POST /review/assess"
    }
  ],

  "communication": {
    "protocol": "API-based",
    "principle": "So much necessary, as little as possible",
    "input_format": "JSON",
    "output_format": "JSON"
  },

  "workflow": {
    "phase_1": {
      "name": "Requirements & Planning",
      "sequence": [
        "Orchestrator analyzes requirements, creates use-case diagram",
        "Doc-Agent creates additional UML diagrams based on use-case",
        "Developer roadmap is established"
      ]
    },
    "phase_2": {
      "name": "Iterative Development (per Use-Case)",
      "sequence": [
        "Diagrams are finalized (all relevant UML diagrams available)",
        "Test-Agent writes tests (TDD first)",
        "Doc-Agent documents tests",
        "Dev-Agent implements code to pass tests",
        "Doc-Agent documents code, updates diagrams",
        "Review-Agent assesses (max 3 attempts, then user escalation)",
        "User reviews feature (code + documentation + diagrams)",
        "User approves → Go to next use-case OR Feedback → back to orchestrator"
      ]
    }
  },

  "quality_gates": {
    "review_criteria": [
      "Clean Code (naming, function size, DRY)",
      "KISS Principle (no over-engineering)",
      "Test Coverage (>80%)",
      "Error Handling (explicit, clear)",
      "Code Documentation (inline comments)",
      "Performance (no N+1 queries, efficient)",
      "Security (input validation, SQL injection, XSS, secrets)"
    ],
    "escalation": {
      "trigger": "3 failed reviews on same use-case",
      "action": "User consultation required",
      "notification": "Escalation notice to user"
    }
  },

  "documentation": {
    "format": "HTML with embedded draw.io diagrams",
    "contents": [
      "Use-Case Diagram",
      "Class Diagram",
      "Component Diagram",
      "Deployment Diagram",
      "Sequence Diagrams",
      "Architecture Decision Log",
      "Code Documentation",
      "API Documentation"
    ]
  },

  "storage": {
    "location": "C:\\Users\\bened\\source\\repos\\FoodDatabase\\claude",
    "structure": {
      "agents": "agents/",
      "config": "orchestration-config.json",
      "design": "ORCHESTRATION-DESIGN.md",
      "outputs": "orchestration/outputs/"
    }
  },

  "constraints": {
    "requirements_gathering": "Once at start, no changes during development",
    "diagrams_before_code": "All relevant UML diagrams must exist before Test/Dev agents start",
    "tdd_order": "Test first, then code",
    "documentation": "Continuous (not at end)",
    "clean_code_strict": true,
    "kiss_principle_strict": true
  }
}

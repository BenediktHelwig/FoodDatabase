@page "/lagerbestand/neu"
@page "/lagerbestand/{Id:int}/bearbeiten"
@using FoodDatabase.App.Models
@using FoodDatabase.App.Services.Interfaces
@inject IProduktInstanzService ProduktInstanzService
@inject ILebensmittelService LebensmittelService
@inject ILagerortService LagerortService
@inject NavigationManager NavigationManager

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h2>@(Id == 0 ? "Neue Packung" : "Packung bearbeiten")</h2>

            @if (lädt)
            {
                <div class="alert alert-info">
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    Lädt...
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(fehler))
                {
                    <div class="alert alert-danger" data-testid="alert-fehler">
                        @fehler
                    </div>
                }

                <EditForm Model="model" OnValidSubmit="SpeichernAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-warning" />

                    <div class="mb-3">
                        <label for="lebensmittel" class="form-label">Lebensmittel *</label>
                        <InputSelect id="lebensmittel"
                                     @bind-Value="model.LebensmittelKatalogId"
                                     class="form-select"
                                     data-testid="select-lebensmittel"
                                     disabled="@(Id > 0)">
                            <option value="0">-- Lebensmittel wählen --</option>
                            @foreach (var lm in alleLebensmittel)
                            {
                                <option value="@lm.Id">@lm.Name (@lm.Einheit)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => model.LebensmittelKatalogId" />
                    </div>

                    <div class="mb-3">
                        <label for="menge" class="form-label">Menge *</label>
                        <InputNumber id="menge"
                                     @bind-Value="model.Menge"
                                     class="form-control"
                                     placeholder="z.B. 500"
                                     data-testid="input-menge" />
                        <ValidationMessage For="() => model.Menge" />
                    </div>

                    <div class="mb-3">
                        <label for="verfallsdatum" class="form-label">Verfallsdatum *</label>
                        <InputDate id="verfallsdatum"
                                   @bind-Value="model.Verfallsdatum"
                                   class="form-control"
                                   data-testid="input-verfallsdatum" />
                        <ValidationMessage For="() => model.Verfallsdatum" />
                    </div>

                    <div class="mb-3">
                        <label for="lagerort" class="form-label">Lagerort *</label>
                        <InputSelect id="lagerort"
                                     @bind-Value="model.LagerortAuswahl"
                                     class="form-select"
                                     data-testid="select-lagerort">
                            <option value="">-- Lagerort wählen --</option>
                            @foreach (Lagerort lagerort in alleLagerorte)
                            {
                                <option value="@lagerort.Id">@lagerort.Name</option>
                            }
                            <option value="@NeuerLagerortWert">Neuer Lagerort…</option>
                        </InputSelect>
                        @if (model.LagerortAuswahl == NeuerLagerortWert)
                        {
                            <InputText id="neuer-lagerort"
                                       @bind-Value="model.NeuerLagerortName"
                                       class="form-control mt-2"
                                       placeholder="Name des neuen Lagerorts"
                                       data-testid="input-neuer-lagerort" />
                        }
                        @if (!string.IsNullOrEmpty(lagerortFehler))
                        {
                            <div class="text-danger mt-1" data-testid="lagerort-fehler">@lagerortFehler</div>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary"
                                data-testid="btn-speichern"
                                disabled="@(lädt || !string.IsNullOrEmpty(fehler))">
                            Speichern
                        </button>
                        <a href="/lagerbestand" class="btn btn-secondary" data-testid="btn-abbrechen">
                            Abbrechen
                        </a>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private ProduktInstanzFormModel model = new ProduktInstanzFormModel();
    private List<LebensmittelKatalog> alleLebensmittel = new();
    private List<Lagerort> alleLagerorte = new();
    private const string NeuerLagerortWert = "neu";
    private string fehler = "";
    private string lagerortFehler = "";
    private bool lädt = false;

    protected override async Task OnInitializedAsync()
    {
        await LadeLebensmittel();
        await LadeLagerorte();

        // Ohne vorhandene Lagerorte gibt es nichts zu wählen: Neu ist vorausgewählt
        if (Id == 0 && !alleLagerorte.Any())
        {
            model.LagerortAuswahl = NeuerLagerortWert;
        }

        if (Id > 0)
        {
            lädt = true;
            try
            {
                var instanz = await ProduktInstanzService.GetByIdAsync(Id);
                if (instanz is not null)
                {
                    model.LebensmittelKatalogId = instanz.LebensmittelKatalogId;
                    model.Menge = instanz.Menge;
                    model.Verfallsdatum = instanz.Verfallsdatum;
                    model.LagerortAuswahl = instanz.LagerortId.ToString();
                }
            }
            catch (Exception ex)
            {
                fehler = $"Fehler beim Laden der Packung: {ex.Message}";
            }
            finally
            {
                lädt = false;
            }
        }
    }

    private async Task LadeLebensmittel()
    {
        try
        {
            var result = await LebensmittelService.GetAllLebensmittelAsync();
            alleLebensmittel = result.ToList();
        }
        catch (Exception ex)
        {
            fehler = $"Fehler beim Laden der Lebensmittel: {ex.Message}";
        }
    }

    private async Task LadeLagerorte()
    {
        try
        {
            IEnumerable<Lagerort> result = await LagerortService.GetAlleLagerorte();
            alleLagerorte = result.OrderBy(l => l.Name).ToList();
        }
        catch (Exception ex)
        {
            fehler = $"Fehler beim Laden der Lagerorte: {ex.Message}";
        }
    }

    private async Task SpeichernAsync()
    {
        lädt = true;
        fehler = "";
        lagerortFehler = "";
        try
        {
            int? lagerortId = await ErmittleLagerortIdAsync();
            if (lagerortId is null)
            {
                lädt = false;
                return;
            }

            if (Id == 0)
            {
                await ProduktInstanzService.CreateAsync(
                    model.LebensmittelKatalogId,
                    model.Menge,
                    model.Verfallsdatum,
                    lagerortId.Value);
            }
            else
            {
                await ProduktInstanzService.UpdateAsync(
                    Id,
                    model.Menge,
                    model.Verfallsdatum,
                    lagerortId.Value);
            }

            NavigationManager.NavigateTo("/lagerbestand");
        }
        catch (ArgumentException ex)
        {
            fehler = $"Eingabefehler: {ex.Message}";
            lädt = false;
        }
        catch (Exception ex)
        {
            fehler = $"Fehler beim Speichern: {ex.Message}";
            lädt = false;
        }
    }

    /// <summary>
    /// Liefert die Id des gewählten Lagerorts. Bei „Neuer Lagerort…“ wird der Name über UC9
    /// (GetOrCreateAsync) validiert, normalisiert und angelegt bzw. der bestehende Lagerort geliefert.
    /// Eingabefehler landen am Lagerort-Feld (nicht im allgemeinen Fehler, der den Button sperrt);
    /// dann ist das Ergebnis null.
    /// </summary>
    private async Task<int?> ErmittleLagerortIdAsync()
    {
        if (model.LagerortAuswahl == NeuerLagerortWert)
        {
            if (string.IsNullOrWhiteSpace(model.NeuerLagerortName))
            {
                lagerortFehler = "Bitte einen Namen für den neuen Lagerort eingeben.";
                return null;
            }

            try
            {
                Lagerort lagerort = await LagerortService.GetOrCreateAsync(model.NeuerLagerortName);

                // Der Lagerort existiert jetzt: Auswahl darauf umstellen, damit ein Wiederholen
                // nach einem späteren Fehler keinen zweiten Anlegeversuch auslöst.
                if (!alleLagerorte.Any(l => l.Id == lagerort.Id))
                {
                    alleLagerorte.Add(lagerort);
                    alleLagerorte = alleLagerorte.OrderBy(l => l.Name).ToList();
                }
                model.LagerortAuswahl = lagerort.Id.ToString();
                return lagerort.Id;
            }
            catch (ArgumentException ex)
            {
                lagerortFehler = ex.Message;
                return null;
            }
        }

        if (!int.TryParse(model.LagerortAuswahl, out int gewählteId) || gewählteId <= 0)
        {
            lagerortFehler = "Bitte einen Lagerort wählen.";
            return null;
        }

        return gewählteId;
    }

    private class ProduktInstanzFormModel
    {
        public int LebensmittelKatalogId { get; set; }
        public decimal Menge { get; set; }
        public DateTime Verfallsdatum { get; set; } = DateTime.Today.AddDays(30);

        /// <summary>Leer = keine Auswahl, sonst Lagerort-Id oder <c>neu</c> (= neuen Lagerort eintragen).</summary>
        public string LagerortAuswahl { get; set; } = "";

        public string NeuerLagerortName { get; set; } = "";
    }
}

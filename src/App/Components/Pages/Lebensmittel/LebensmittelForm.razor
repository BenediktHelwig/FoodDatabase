@page "/lebensmittel/neu"
@page "/lebensmittel/{Id:int}/bearbeiten"
@using FoodDatabase.App.Models
@using FoodDatabase.App.Services.Interfaces
@inject ILebensmittelService LebensmittelService
@inject NavigationManager NavigationManager

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h2>@(Id == 0 ? "Neues Lebensmittel" : "Lebensmittel bearbeiten")</h2>

            @if (lädt)
            {
                <div class="alert alert-info">
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    Lädt...
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(fehler))
                {
                    <div class="alert alert-danger" data-testid="alert-fehler">
                        @fehler
                    </div>
                }

                <EditForm Model="lebensmittel" OnValidSubmit="SpeichernAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-warning" />

                    <div class="mb-3">
                        <label for="name" class="form-label">Name *</label>
                        <InputText id="name"
                                   @bind-Value="lebensmittel.Name"
                                   class="form-control"
                                   placeholder="z.B. Mehl"
                                   data-testid="input-name" />
                        <ValidationMessage For="() => lebensmittel.Name" />
                    </div>

                    <div class="mb-3">
                        <label for="einheit" class="form-label">Einheit *</label>
                        <InputSelect id="einheit"
                                     @bind-Value="lebensmittel.Einheit"
                                     class="form-select"
                                     data-testid="select-einheit">
                            <option value="">-- Einheit wählen --</option>
                            <option value="g">Gramm (g)</option>
                            <option value="ml">Milliliter (ml)</option>
                            <option value="Stück">Stück</option>
                        </InputSelect>
                        <ValidationMessage For="() => lebensmittel.Einheit" />
                    </div>

                    <div class="mb-3">
                        <label for="kategorie" class="form-label">Kategorie *</label>
                        <InputText id="kategorie"
                                   @bind-Value="lebensmittel.Kategorie"
                                   class="form-control"
                                   placeholder="z.B. Getreide"
                                   data-testid="input-kategorie" />
                        <ValidationMessage For="() => lebensmittel.Kategorie" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary"
                                data-testid="btn-speichern"
                                disabled="@(lädt || !string.IsNullOrEmpty(fehler))">
                            Speichern
                        </button>
                        <a href="/lebensmittel" class="btn btn-secondary" data-testid="btn-abbrechen">
                            Abbrechen
                        </a>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private LebensmittelKatalog lebensmittel = new LebensmittelKatalog();
    private bool lädt = false;
    private string fehler = "";

    protected override async Task OnInitializedAsync()
    {
        if (Id > 0)
        {
            lädt = true;
            try
            {
                lebensmittel = await LebensmittelService.GetLebensmittelByIdAsync(Id);
            }
            catch (Exception ex)
            {
                fehler = $"Fehler beim Laden des Lebensmittels: {ex.Message}";
            }
            finally
            {
                lädt = false;
            }
        }
        else
        {
            lebensmittel = new LebensmittelKatalog();
        }
    }

    private async Task SpeichernAsync()
    {
        lädt = true;
        fehler = "";
        try
        {
            if (Id == 0)
            {
                await LebensmittelService.CreateLebensmittelAsync(lebensmittel);
            }
            else
            {
                await LebensmittelService.UpdateLebensmittelAsync(lebensmittel);
            }

            NavigationManager.NavigateTo("/lebensmittel");
        }
        catch (ValidationException ex)
        {
            fehler = $"Validierungsfehler: {ex.Message}";
            lädt = false;
        }
        catch (ArgumentException ex)
        {
            fehler = $"Eingabefehler: {ex.Message}";
            lädt = false;
        }
        catch (Exception ex)
        {
            fehler = $"Fehler beim Speichern: {ex.Message}";
            lädt = false;
        }
    }
}

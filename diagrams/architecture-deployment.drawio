        <mxCell id="connContainerApp" value="" style="endArrow=open;html=1;rounded=0;entryX=0.5;entryY=0;exitX=0.5;exitY=1;strokeWidth=2;strokeColor:#000000;" edge="1" parent="1" source="dockerContainer" target="aspnetApp"/>

        <!-- TrueNAS Filesystem -->
        <mxCell id="filesystem" value="TrueNAS Filesystem&#10;─────────────────────────────&#10;- Path: /mnt/pool/fooddb-data&#10;- Permissions: 755&#10;- Owner: docker:docker" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;fillColor=#f0f0f0;strokeWidth=2;strokeColor=#666666;" vertex="1" parent="1">

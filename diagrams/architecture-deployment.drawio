        <mxCell id="backup" value="Backup Strategy&#10;─────────────────────────────&#10;- Frequency: Daily (Cron)&#10;- Target: TrueNAS ZFS Snapshot&#10;- Retention: 7 days&#10;- Method: SQLite dump" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontFamily=Courier New;align=center;verticalAlign=middle;fillColor=#f8c6f8;strokeWidth=2;strokeColor=#cc00cc;" vertex="1" parent="1">

                <!-- Step 2: UI ruft GetLagerorteMitAutoComplete auf -->
                <mxCell id="msg1_2" value="2: GetLagerorteMitAutoComplete(&quot;lager&quot;)" style="html=1;verticalAlign=bottom;endArrow=block;entryX=0;entryY=0;" parent="1" edge="1">

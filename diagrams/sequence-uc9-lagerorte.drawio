                <!-- Step 1: User gibt Lagerort ein -->
                <mxCell id="msg1_1" value="1: Input &quot;lagerA&quot; (User gibt Text ein)" style="html=1;verticalAlign=bottom;endArrow=block;entryX=0;entryY=0;" parent="1" edge="1">

                <!-- Step 8: Service prüft ob existiert oder erstellt neu -->
                <mxCell id="msg1_8" value="8: GetOrCreate(&quot;LagerC&quot;)" style="html=1;verticalAlign=bottom;endArrow=block;entryX=0;entryY=0;" parent="1" edge="1">

                <!-- Technical Notes -->
                <mxCell id="tech_note" value="⚡ Tech-Details: Fuzzy-Matching ist Case-Insensitive (Input &quot;lag&quot;), aber Speicherung Case-Sensitive (&quot;LagerA&quot;). Normalisierung: Single-Word → Capitalize (&quot;lagerX&quot; → &quot;LagerX&quot;, &quot;LAGERX&quot; → &quot;LagerX&quot;)" style="text;html=1;strokeColor=none;fillColor=#fff3e0;align=left;verticalAlign=top;fontStyle=italic;fontSize=9;" parent="1" vertex="1">

                <!-- Step 7: Normalisierung -->
                <mxCell id="msg1_7" value="7: ValidateLagerort(input) + NormaliseLagerort(&quot;lagerC&quot; → &quot;LagerC&quot;)" style="html=1;verticalAlign=bottom;endArrow=block;entryX=0;entryY=0;" parent="1" edge="1">

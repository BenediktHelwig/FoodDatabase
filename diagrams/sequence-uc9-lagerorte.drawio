                <mxCell id="msg1_11" value="11: Return Lagerort(Id=3, Name=&quot;LagerC&quot;)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;exitX=0;exitY=0;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">

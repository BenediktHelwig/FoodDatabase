                        <mxPoint x="540" y="440" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>

                <!-- Step 9: Check if exists -->
                <mxCell id="msg1_9" value="9: SELECT * WHERE Name = &quot;LagerC&quot;" style="html=1;verticalAlign=bottom;endArrow=block;entryX=0;entryY=0;" parent="1" edge="1">

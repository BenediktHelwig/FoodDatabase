                        <mxPoint x="370" y="250" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>

                <!-- Step 3: Service macht Fuzzy-Match (partial prefix) -->
                <mxCell id="msg1_3" value="3: Fuzzy-Match im Cache (Memory/DB)" style="html=1;verticalAlign=bottom;endArrow=block;entryX=0;entryY=0;" parent="1" edge="1">

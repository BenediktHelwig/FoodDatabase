                        <mxPoint x="370" y="280" as="sourcePoint"/>
                        <mxPoint x="540" y="280" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>

                <!-- Step 4: Repo antwortet mit Matches -->
                <mxCell id="msg1_4" value="4: GetAll() → [&quot;LagerA&quot;, &quot;LagerB&quot;]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;exitX=0;exitY=0;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="540" y="310" as="sourcePoint"/>
                        <mxPoint x="370" y="310" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>

                <!-- Step 5: Service antwortet mit Auto-Complete-Vorschlägen -->
                <mxCell id="msg1_5" value="5: Auto-Complete Suggeste [&quot;LagerA&quot;, &quot;LagerB&quot;]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;exitX=0;exitY=0;" parent="1" edge="1">
